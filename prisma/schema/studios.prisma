model Studios {
  id          String    @id @default(cuid())
  name        String
  description String?
  location    String?
  foundedAt   DateTime? @map("founded_at")
  followers   Int       @default(0)

  films Content[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("studios")
}
