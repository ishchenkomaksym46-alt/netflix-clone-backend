model RefreshTokens {
  id     String @id @default(cuid())
  token  String @unique
  userId String @unique @map("user_id")
  user   Users  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("refresh_tokens")
}
