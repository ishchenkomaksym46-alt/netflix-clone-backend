model Content {
  id          String  @id @default(cuid())
  title       String
  description String?
  year        Int
  ageRating   String  @map("age_rating")
  likes       Int     @default(0)
  director    String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content")
}
